# App
APP_ENV=production

# Ports
BACKEND_PORT=5566
MAIN_PORT=5567
MYSQL_PORT=3306

# MySQL
MYSQL_DATABASE=vodda
MYSQL_USER=vodda
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_DB_ROOT_PASSWORD

# JWT (keep stable across deploys)
JWT_ACCESS_SECRET=CHANGE_ME_LONG_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_LONG_RANDOM_REFRESH_SECRET
PLATFORM_COMMISSION_PERCENT=15

# Frontend -> Backend public URL
# Set to your real domain/IP and backend port
NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP:5566

# ملی پیامک (Melipayamak)
SMS_API_KEY=
SMS_BODY_ID=
SMS_SENDER=Vodda
