# App
APP_ENV=development

# Ports
BACKEND_PORT=5566
MAIN_PORT=5567
MYSQL_PORT=3306

# MySQL
MYSQL_DATABASE=vodda
MYSQL_USER=vodda
MYSQL_PASSWORD=vodda
MYSQL_ROOT_PASSWORD=vodda

# JWT
JWT_ACCESS_SECRET=your-secret
JWT_REFRESH_SECRET=your-refresh-secret
PLATFORM_COMMISSION_PERCENT=15

# API URL (for main and app when calling backend)
NEXT_PUBLIC_API_URL=http://localhost:5566

# ملی پیامک (Melipayamak) - ارسال کد OTP
# توکن از پنل ملی پیامک: https://console.melipayamak.com
# BodyID مربوط به قالب پیامک است (مثلاً: کد تأیید شما: {0})
SMS_API_KEY=
SMS_BODY_ID=
SMS_SENDER=Vodda

# سرویس‌های خارجی (بعداً)
# ZARINPAL_MERCHANT_ID=
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
