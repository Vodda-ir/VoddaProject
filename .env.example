APP_ENV=development
APP_TIMEZONE=Asia/Tehran
DOCKER_PLATFORM=linux/amd64

# ── ports (host) ──
BACKEND_PORT=3420
FRONTEND_PORT=3421
MYSQL_PORT=3422
MONAFASEH_PORT=3423

# ── Monafaseh ──
MONAFASEH_NEXTAUTH_SECRET=
MONAFASEH_NEXTAUTH_URL=http://localhost:3423
MONAFASEH_SITE_URL=http://localhost:3423
MONAFASEH_BOT_TOKEN=
# ── درگاه پرداخت سامان‌سپ (بازسازی دقیق مطابق منافسه) ──
# SITE_URL مبدأ عمومی HTTPS ثبت‌شدهٔ پذیرنده است (بدون path/query)؛ آدرس بازگشت
# (کال‌بک) از همین مبدأ ساخته می‌شود و سپ همان را enforce می‌کند. توکن بانک در
# پاسخ JSON به فرانت داده می‌شود و مرورگر کاربر فرم POST را به OnlinePG می‌فرستد.
SITE_URL=https://vodda.ir
# تنها شناسهٔ لازم برای کل جریان (صدور توکن + VerifyTransaction) همین است؛
# نام کاربری/رمز پنل و شناسهٔ پذیرنده در جریان جدید نقشی ندارند.
SAMAN_TERMINAL_ID=31136631
SAMAN_BASE_URL=https://sep.shaparak.ir

# ── internal container ports ──
BACKEND_INTERNAL_PORT=3420
FRONTEND_INTERNAL_PORT=3421

# ── database ──
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=vodda_secret
DB_NAME=vodda

# ── urls / cors ──
FRONTEND_BASE_URL=http://localhost:3421
CORS_ALLOWED_ORIGINS=http://localhost:3421
NEXT_PUBLIC_API_BASE_URL=/api/v1
SERVER_API_URL=http://backend:3420/api/v1

# ── auth / otp ──
JWT_SECRET=change-me-in-production-with-at-least-32-random-characters
TOKEN_EXPIRATION=720h
OTP_EXPIRATION=2m
OTP_RESEND_COOLDOWN=2m

# ── sms ──
# Faraz SMS settings used by the previous Laravel app's OTP template.
SMS_PROVIDER=faraz
SMS_FARAZ_API_URL=https://ippanel.com/patterns/pattern
SMS_FARAZ_USERNAME=
SMS_FARAZ_PASSWORD=
SMS_FARAZ_FROM=3000505
SMS_FARAZ_PATTERN_CODE=j4skcu7fjd1jjjz
SMS_REQUEST_TIMEOUT=20s

# Optional legacy provider. Use SMS_PROVIDER=sms.ir to select it.
SMS_API_URL=https://api.sms.ir/v1/send/verify
SMS_API_KEY=
SMS_BODY_ID=0

# ── otp test bypass (development only) ──
OTP_TEST_BYPASS_ENABLED=true
OTP_TEST_CODE=33365
# Empty means the development code works for all seeded mobile numbers.
OTP_TEST_MOBILE=

# ── development data and wallet ──
AUTO_SEED=true
# Allows POST /wallet/charge without a gateway only in non-production environments.
DEV_WALLET_CHARGE_ENABLED=true

# ── payment (zarinpal) ──
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# ── platform commission (percent) ──
PLATFORM_COMMISSION_PERCENT=15
