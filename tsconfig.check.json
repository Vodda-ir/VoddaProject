{
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "target": "ES2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "src/app/dispatch/page.tsx",
    "src/lib/api.ts",
    "src/lib/auth.ts",
    "src/lib/persian.ts",
    "src/components/web/ui.tsx",
    "src/components/web/sections.tsx",
    "src/app/teachers/[id]/page.tsx",
    "src/app/panel/teacher/dispatch/page.tsx",
    "src/app/panel/teacher/profile/page.tsx",
    "src/app/panel/user/wallet/page.tsx",
    "src/components/Icon.tsx"
  ]
}
