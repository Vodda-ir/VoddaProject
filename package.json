{
  "name": "vodda-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${PORT:-3421} -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p ${PORT:-3421} -H 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test tests/*.test.mjs",
    "native:dev": "npm --prefix native run dev",
    "native:build": "npm --prefix native run build",
    "cap:sync": "npm --prefix native run cap:sync",
    "cap:android": "npm --prefix native run cap:android",
    "cap:ios": "npm --prefix native run cap:ios"
  },
  "dependencies": {
    "next": "15.5.20",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2"
  }
}
