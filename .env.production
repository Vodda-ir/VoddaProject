APP_ENV=production
DOCKER_PLATFORM=linux/amd64

# ── ports (host) ──
BACKEND_PORT=3420
FRONTEND_PORT=3421
MYSQL_PORT=3422

# ── internal container ports ──
BACKEND_INTERNAL_PORT=3420
FRONTEND_INTERNAL_PORT=3421

# ── database ──
DB_HOST=mysql
DB_PORT=3306
DB_USER=vodda
DB_PASSWORD=7d6dc0dfccb494a294d9e7fcef3da0bffe7ed246cbea56b633d25c68b6cabd06
DB_NAME=vodda

# ── urls ──
FRONTEND_BASE_URL=https://vodda.ir
NEXT_PUBLIC_API_BASE_URL=/api/v1
SERVER_API_URL=http://backend:3420/api/v1

# ── auth / otp ──
JWT_SECRET=ce41279c3e941445f18b8ae3e92d05fca97eae49b43a3be86e59dbd8d17f5ea3
TOKEN_EXPIRATION=720h
OTP_EXPIRATION=2m
OTP_RESEND_COOLDOWN=2m

# ── sms (sms.ir) ──
SMS_API_URL=https://api.sms.ir/v1/send/verify
