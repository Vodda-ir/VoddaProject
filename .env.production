APP_ENV=production
DOCKER_PLATFORM=linux/amd64

# ── ports (host) ──
BACKEND_PORT=3420
FRONTEND_PORT=3421
MYSQL_PORT=3422

# ── internal container ports ──
BACKEND_INTERNAL_PORT=3420
FRONTEND_INTERNAL_PORT=3421

# ── database ──
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DB_NAME=vodda

# ── urls ──
FRONTEND_BASE_URL=https://vodda.ir
NEXT_PUBLIC_API_BASE_URL=/api/v1
SERVER_API_URL=http://backend:3420/api/v1

# ── auth / otp ──
JWT_SECRET=REPLACE_WITH_STRONG_SECRET
TOKEN_EXPIRATION=720h
OTP_EXPIRATION=2m
OTP_RESEND_COOLDOWN=2m

# ── sms (sms.ir) ──
SMS_API_URL=https://api.sms.ir/v1/send/verify
SMS_API_KEY=
SMS_BODY_ID=0
SMS_REQUEST_TIMEOUT=20s

# ── otp test bypass (dev only) ──
OTP_TEST_BYPASS_ENABLED=false
OTP_TEST_CODE=
OTP_TEST_MOBILE=

# ── seeding ──
AUTO_SEED=false

# ── payment (zarinpal) ──
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

# ── platform commission (percent) ──
PLATFORM_COMMISSION_PERCENT=15
