upstream vodda_frontend {
    server 127.0.0.1:3421;
    keepalive 32;
}

upstream vodda_backend {
    server 127.0.0.1:3420;
    keepalive 16;
}

upstream monafaseh_app {
    server 127.0.0.1:3423;
    keepalive 16;
}

upstream bashar_app {
    server 127.0.0.1:3424;
    keepalive 16;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name __SITE_DOMAIN__;
    client_max_body_size 10m;

    # ── وودّا نسخه ۲: سایت استاتیک جدید (web/) روی ریشه دامنه اصلی ──
    # اول فایل استاتیک جدید سرو می‌شود؛ هر مسیری که فایل استاتیکی نداشته باشد
    # به فرانت‌اند قبلی پروکسی می‌شود تا هیچ کارکردی از دست نرود.
    index index.html;
    root /var/www/vodda-web;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 120s;

    # assetهای اپ کاربردی (Next.js) همیشه از فرانت‌اند قبلی
    location ^~ /_next/ {
        proxy_pass http://vodda_frontend;
    }

    location ^~ /uploads/ {
        proxy_pass http://vodda_backend;
    }

    # نسخه تمیز URL: هر /page بدون پسوند → فایل page.html سایت استاتیک جدید
    location / {
        try_files $uri $uri.html $uri/ @vodda_frontend;
    }

    location @vodda_frontend {
        proxy_pass http://vodda_frontend;
    }
}

server {
    listen 80;
    server_name __APP_DOMAIN__;
    client_max_body_size 10m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 120s;

    location = /app {
        return 308 /;
    }

    location ^~ /app/ {
        rewrite ^/app(/.*)$ $1 permanent;
    }

    location ^~ /_next/ {
        proxy_pass http://vodda_frontend;
    }

    location ^~ /api/ {
        proxy_pass http://vodda_frontend;
    }

    location ^~ /uploads/ {
        proxy_pass http://vodda_frontend;
    }

    location ~* \.(?:avif|css|eot|gif|ico|jpe?g|js|json|map|png|svg|ttf|webmanifest|webp|woff2?)$ {
        proxy_pass http://vodda_frontend;
    }

    location / {
        rewrite ^/$ /app break;
        rewrite ^/(.*)$ /app/$1 break;
        proxy_pass http://vodda_frontend;
    }
}

server {
    listen 80;
    server_name __API_DOMAIN__;
    client_max_body_size 10m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 120s;

    location ^~ /api/ {
        proxy_pass http://vodda_backend;
    }

    location ^~ /uploads/ {
        proxy_pass http://vodda_backend;
    }

    location = /health {
        proxy_pass http://vodda_backend;
    }

    location = /live {
        proxy_pass http://vodda_backend;
    }

    location = /ready {
        proxy_pass http://vodda_backend;
    }

    location / {
        return 404;
    }
}

server {
    listen 80;
    server_name __MONAFASEH_DOMAIN__;
    client_max_body_size 20m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 120s;

    location / {
        proxy_pass http://monafaseh_app;
    }
}

# خبرگزاری بشر — روی IP خود سرور (بدون دامنه)، مستقل از CDN
server {
    listen 80;
    server_name __BASHAR_HOST__;
    # سقف آپلود فایل (عکس/ویدئو/PDF) — با سقف ۳۰ مگابای اپ هماهنگ + سرباره multipart
    client_max_body_size 64m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 120s;

    # دانلود مستقیم فایل‌ها (مثل APK اندروید) — از دیتابیس اپ جدا است
    location /download/ {
        alias /var/www/bashar-download/;
        types {
            application/vnd.android.package-archive apk;
        }
        default_type application/octet-stream;
    }

    location / {
        proxy_pass http://bashar_app;
    }
}
