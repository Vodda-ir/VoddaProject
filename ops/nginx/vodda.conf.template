upstream vodda_frontend {
    server 127.0.0.1:3421;
    keepalive 32;
}

upstream vodda_backend {
    server 127.0.0.1:3420;
    keepalive 16;
}

# منافسه (upstream monafaseh_app) در فایل جدا monafaseh.conf روی سرور تعریف می‌شود
# (دامنه‌ها: __MONAFASEH_DOMAIN__ — این فایل را دست نزنید)

upstream bashar_app {
    server 127.0.0.1:3424;
    keepalive 16;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80 default_server;
    server_name _;
    return 444;
}

# www.X.X to apex — the CDN forwards www traffic here; serve a canonical redirect
server {
    listen 80;
    server_name www.__SITE_DOMAIN__;
    return 301 https://__SITE_DOMAIN__$request_uri;
}

server {
    listen 80;
    server_name __SITE_DOMAIN__;
    client_max_body_size 10m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 120s;

    # پروژه اصلی ودا: اپ Next.js مستقیماً روی ریشه دامنه اصلی سرو می‌شود
    location / {
        proxy_pass http://vodda_frontend;
    }
}

server {
    listen 80;
    server_name __APP_DOMAIN__;
    client_max_body_size 10m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 120s;

    location = /app {
        return 308 /;
    }

    location ^~ /app/ {
        rewrite ^/app(/.*)$ $1 permanent;
    }

    location ^~ /_next/ {
        proxy_pass http://vodda_frontend;
    }

    location ^~ /api/ {
        proxy_pass http://vodda_frontend;
    }

    location ^~ /uploads/ {
        proxy_pass http://vodda_frontend;
    }

    location ~* \.(?:avif|css|eot|gif|ico|jpe?g|js|json|map|png|svg|ttf|webmanifest|webp|woff2?)$ {
        proxy_pass http://vodda_frontend;
    }

    location / {
        rewrite ^/$ /app break;
        rewrite ^/(.*)$ /app/$1 break;
        proxy_pass http://vodda_frontend;
    }
}

server {
    listen 80;
    server_name __API_DOMAIN__;
    client_max_body_size 10m;

    # تونل SSH-over-WebSocket برای دیپلوی (دور زدن محدودیت Iran Access روی پورت ۲۲)
    # مسیر دقیق شامل توکن است و پل سمت سرور مسیر را اعتبارسنجی می‌کند.
    location ^~ /wsssh/ {
        proxy_pass http://127.0.0.1:8123;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 120s;

    location ^~ /api/ {
        proxy_pass http://vodda_backend;
    }

    location ^~ /uploads/ {
        proxy_pass http://vodda_backend;
    }

    location = /health {
        proxy_pass http://vodda_backend;
    }

    location = /live {
        proxy_pass http://vodda_backend;
    }

    location = /ready {
        proxy_pass http://vodda_backend;
    }

    location / {
        return 404;
    }
}

# بلاک سرور منافسه در فایل جدا monafaseh.conf روی سرور نگهداری می‌شود
# (server_name: monafeseh.ir monafaseh.vodda.ir www.monafeseh.ir)

# خبرگزاری بشر — روی IP خود سرور (بدون دامنه)، مستقل از CDN
server {
    listen 80;
    server_name __BASHAR_HOST__;
    # سقف آپلود فایل (عکس/ویدئو/PDF) — با سقف ۳۰ مگابای اپ هماهنگ + سرباره multipart
    client_max_body_size 64m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 120s;

    # فایل‌های آپلودی کاربران (عکس/ویدئوی خبر، پیوست آموزش و تالار)
    # مستقیم از volume سرو می‌شوند — Next.js پوشه public را فقط در زمان استارت کش
    # می‌کند و آپلودهای جدید را 404 می‌دهد؛ انجینکس همیشه فایل‌های تازه را می‌بیند.
    location /uploads/ {
        alias /www/wwwroot/vodda/bashar-uploads/;
        types {
            image/jpeg jpg jpeg;
            image/png png;
            image/webp webp;
            image/gif gif;
            video/mp4 mp4 m4v;
            video/webm webm;
            video/quicktime mov;
            application/pdf pdf;
        }
        default_type application/octet-stream;
        add_header Cache-Control "public, max-age=3600";
        add_header Accept-Ranges bytes;
    }

    # دانلود مستقیم فایل‌ها (مثل APK اندروید) — از دیتابیس اپ جدا است
    location /download/ {
        alias /var/www/bashar-download/;
        types {
            application/vnd.android.package-archive apk;
        }
        default_type application/octet-stream;
    }

    location / {
        proxy_pass http://bashar_app;
    }
}
