# Dockerfile for debugging backend (hot-reload with Air)
# syntax=docker/dockerfile:1
FROM golang:1.24-alpine

# Use alternate proxy (proxy.golang.org may be unreachable in some regions)
ENV GOPROXY=https://goproxy.io,direct

# Install Air for hot-reload (v1.52 compatible with Go 1.24)
RUN --mount=type=cache,target=/go/pkg/mod go install github.com/air-verse/air@v1.52.3

WORKDIR /app

# Copy go mod files first for better layer caching
COPY go.mod go.sum* ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

# Copy source (will be overridden by volume mount in compose)
COPY . .

# Expose backend port
EXPOSE 5566

# Run with Air for hot-reload - rebuild on file changes
CMD ["air", "-c", ".air.toml"]
