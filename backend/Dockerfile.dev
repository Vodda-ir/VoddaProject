# Development image with hot-reload via air.
FROM golang:1.25-bookworm
WORKDIR /app

# Keep the dev tool compatible with the Go version in this image.  Using
# @latest is not reproducible and currently resolves to a release requiring
# Go 1.26+, while this image intentionally uses Go 1.25.
ARG AIR_VERSION=v1.66.1
RUN go install github.com/air-verse/air@${AIR_VERSION}

COPY go.mod go.sum ./
RUN go mod download

COPY . .
EXPOSE 3420
CMD ["air", "-c", ".air.toml"]
